<!--
    The host looks up the action label and the first-level menu name of the explorer action catalog by resource name
    (getIdentifier), which resource shrinking cannot see; without these entries release builds drop the translations
    and the host falls back to the English labelFallback.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/plugin_instruction,@string/action_inspect_android_package,@string/app_name" />
